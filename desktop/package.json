{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Attual Camisetas - Programa de Lançamento de Pedidos",
  "author": "Attual Camisetas",
  "main": "src/main.cjs",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0"
  },
  "build": {
    "appId": "com.attualcamisetas.pedidos",
    "productName": "Attual - Programa de Pedidos",
    "electronVersion": "33.4.11",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "resources/server", "to": "server" },
      { "from": "resources/web", "to": "web" }
    ],
    "publish": {
      "provider": "github",
      "owner": "Pedrovmfs",
      "repo": "programa-loja",
      "releaseType": "release"
    },
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Attual-Programa-de-Pedidos-Instalador.${ext}"
    },
    "portable": {
      "artifactName": "Attual-Programa-de-Pedidos.${ext}"
    }
  }
}
